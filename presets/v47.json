    { "metric": "bench_int8.full", "op": ">=", "value": 0, "note": "【已降级】int8 参考指标（用户拍板 v47 起 int8 出门：nano 本身是 fp32 部署先例，部署口径独立由部署轮承担；本门恒过，仅报告观测）" },
