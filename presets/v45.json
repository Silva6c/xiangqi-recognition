{
  "name": "v45",
  "note": "v45 续训轮（部署切换单 A/B 线已完成后的模型侧收尾）：init-from v44/gen_best 续训，训练超参与数据源全沿用 v44（贴片库 30102 枚红利续兑）；本轮新变量=训后链新默认 Percentile 50 校准首次全程生效（旧 MinMax 600 被离群帧撑爆 range 是九轮 int8 伤的真根因，v44 权重 Pct50 复验 bench 6/10、human_best 基座部署实测 6/10 总错 4）+ gates 升级：bench_int8 4→6、新增 bench_int8_hb 门（human_best 部署口径，部署基座统一 human_best）。",
  "train": {
    "width": "256,384,640,896",
    "head-dim": 256,
    "attn": true,
    "aux-head": true,
    "aux-weight": 0.4,
    "attn-lr-mult": 10,
    "cell-balance": true,
    "cell-freq": "data/cell_class_freq.npz",
    "init-from": "runs/v44/gen_best.pt",
    "lr": 5e-5,
    "total-samples": 150000,
    "batch": 48,
    "workers": 4,
    "val-every": 50,
    "val-n": 256,
    "real-ratio": 0.5,
    "seed": 2030,
    "real-npz": [
      "data/real_photo_mix.npz",
      "data/real_photo_recover45.npz",
      "data/real_photo_v24.npz",
      "data/real_photo_chessai.npz",
      "data/real_chessai_piece.npz",
      "data/real_rf_piece_hi.npz",
      "data/bench_hot_transplant.npz",
      "data/real_rf_patch_transplant_shard0.npz",
      "data/real_rf_patch_transplant_shard1.npz"
    ],
    "early-stop-patience": 10,
    "select": ["gen-select", "human-select", "bench-select"]
  },
  "gates": [
    { "metric": "human26.real17.err", "op": "<=", "value": 20, "note": "核心预注册：实物域 v44 gen_best 23 → ≤20（贴片红利续兑；human_best 口径 19 已达）" },
    { "metric": "human26_human_best.real17.err", "op": "<=", "value": 19, "note": "实物域 human_best 口径 v44 实绩 19 不退（部署口径主判据）" },
    { "metric": "gen.style.occ",   "op": ">=", "value": 0.833, "note": "v44 0.8380 -0.5pt 防守" },
    { "metric": "gen.piece.occ",   "op": ">=", "value": 0.831, "note": "v44 0.8368 -0.5pt 防守" },
    { "metric": "gen.angle.occ",   "op": ">=", "value": 0.840, "note": "v44 0.8459 -0.5pt 防守" },
    { "metric": "gen.roboflow.occ", "op": ">=", "value": 0.739, "note": "v44 0.7445 -0.5pt 防守" },
    { "metric": "human26.total.err", "op": "<=", "value": 43, "note": "v44 gen_best 43 不退" },
    { "metric": "human26_human_best.total.err", "op": "<=", "value": 36, "note": "v44 human_best 36 历史新低不退" },
    { "metric": "bench.full",      "op": ">=", "value": 6,    "note": "v44 gen_best 6 不退（bench 顽固簇本轮无主变量，守成）" },
    { "metric": "bench_bench_best.full", "op": ">=", "value": 7, "note": "v44 7 不退" },
    { "metric": "bench_int8.full", "op": ">=", "value": 6, "note": "int8 门升级 4→6：v44 权重 Pct50 复验 6/10；v45 起新默认 Percentile 50 校准（calib-n≤100 铁律）" },
    { "metric": "bench_int8_hb.full", "op": ">=", "value": 6, "note": "human_best 部署口径 int8 门（v45 新增）：部署上机模型 human_best+Pct50 实测 6/10 总错 4" }
  ],
  "baseline": {
    "note": "v44 双口径基线（v45 续训轮 delta 基准）。",
    "path": "runs/v44/auto_summary.json"
  }
}
